HOST=0.0.0.0
PORT=3001
APP_BASE_URL=http://localhost:3001
PUBLIC_SITE_BASE_URL=http://localhost:4321
PUBLIC_TICKET_BASE_URL=http://localhost:3001
SQLITE_PATH=./data/registration.sqlite
CORS_ORIGINS=http://localhost:4321
CONSENT_VERSION=draft-1
CONSENT_TEXT_HASH=dev-draft
PII_PUBLIC_KEY_PEM_B64=
PII_PRIVATE_KEY_PEM_B64=
PII_FINGERPRINT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/api/v1/telegram/webhook
EMERGENCY_EXPORT_TOKEN=
REGISTRATION_OPERATING_MODE=production
TICKETS_PREFIX=tickets
EXPORTS_PREFIX=exports
LOCAL_PUBLIC_ROOT=./data/public
TZ=Europe/Kaliningrad
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=https://api.kgd80.ru/api/v1/auth/vk/callback
VK_ID_SCOPE=vkid.personal_info email phone
VK_AUTH_ALLOWED_RETURN_ORIGINS=https://kgd80.ru,https://www.kgd80.ru,http://localhost:4321,http://127.0.0.1:4321

# VK social monitoring for special applications (report-only)
VK_AUTH_TOKEN=
VK_SOCIAL_MONITORING_ENABLED=true
VK_SOCIAL_API_MIN_INTERVAL_MS=1100
VK_SOCIAL_API_MAX_RETRIES=4
VK_SOCIAL_WALL_POST_COUNT=100
VK_SOCIAL_NOTIFICATIONS_MAX_PAGES=8
SOCIAL_MATCH_LLM_ENABLED=true
SOCIAL_MATCH_LLM_MODEL=gemma-4
SOCIAL_MATCH_LLM_URL=
SOCIAL_MATCH_LLM_TIMEOUT_MS=120000
SOCIAL_MATCH_LLM_MIN_INTERVAL_MS=5000
SOCIAL_MATCH_LLM_MAX_RETRIES=2
SOCIAL_MATCH_LLM_BATCH_SIZE=12
