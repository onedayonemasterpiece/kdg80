{
  "name": "registration",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "special:e2e:seed": "tsx scripts/seed-special-e2e-data.ts",
    "telegram:e2e:polling": "tsx scripts/run-telegram-e2e-polling.ts",
    "vk:social:dry-run": "tsx scripts/run-vk-social-sync.ts --dry-run",
    "vk:social:write": "tsx scripts/run-vk-social-sync.ts --write",
    "test:social": "tsx --test src/services/vk-social-monitoring.test.ts",
    "vk:social:write:telegram": "tsx scripts/run-vk-social-sync.ts --write --telegram",
    "vk:social:personal-reports": "tsx scripts/send-vk-social-personal-reports.ts",
    "vk:social:reminders:dry-run": "tsx scripts/send-special-social-reminders.ts",
    "vk:social:reminders:send": "tsx scripts/send-special-social-reminders.ts --send",
    "test:special-social": "tsx --test src/services/special-social-scoring.test.ts",
    "test:special-draws": "tsx --test src/services/special-draws.test.ts",
    "test:special-public-quota": "tsx --test src/services/special-public-quota.test.ts",
    "test:special-test-cleanup": "tsx --test src/services/special-test-cleanup.test.ts",
    "test:special-test-draw-exclusion": "tsx --test src/services/special-test-draw-exclusion.test.ts",
    "test:special-social-reminders": "tsx --test src/services/special-social-reminders.test.ts",
    "test:special-amber-eligibility": "tsx --test src/services/special-amber-eligibility.test.ts src/services/special-winner-email.test.ts",
    "send:amber-winner-preview": "tsx scripts/send-amber-winner-email-preview.ts",
    "create:amber-test-application": "tsx scripts/create-amber-test-application.ts",
    "cleanup:amber-test-application": "tsx scripts/cleanup-amber-test-application.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kinesis": "^3.1077.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "grammy": "^1.38.3",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
