{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:public-assets": "node scripts/prepare_public_assets.mjs",
    "verify:public-assets": "node scripts/verify_public_assets.mjs",
    "dev": "node scripts/prepare_public_assets.mjs && astro dev",
    "video:preview:dev": "node scripts/prepare_public_assets.mjs && astro dev --host 127.0.0.1 --port 4321",
    "video:preview:capture": "node scripts/capture_video_preview.mjs",
    "video:preview:render": "node scripts/render_video_scene.mjs",
    "video:preview:program": "node scripts/render_video_program.mjs",
    "video:preview:sample": "node scripts/render_video_scene.mjs --quality=high --profile=playback-safe --fps=30 --supersample=2",
    "slide:preview:capture": "node scripts/capture_slide_deck.mjs",
    "build": "node scripts/prepare_public_assets.mjs && astro build && node scripts/verify_public_assets.mjs",
    "preview": "node scripts/prepare_public_assets.mjs && astro preview",
    "astro": "astro",
    "passport:pdf": "npm run build && node ../scripts/generate-passport-pdf.mjs"
  },
  "dependencies": {
    "astro": "^6.0.5",
    "playwright": "^1.58.2"
  }
}
