---
import Layout from '../../../src/layouts/Layout.astro';

const routeTitle = 'Паспорт участника фестиваля | 80 историй о главном';
const routeDescription = 'Печатный макет A4 с двумя A5-экземплярами паспорта участника фестиваля «80 историй о главном» к 80-летию Калининградской области.';
const festivalPeriod = '28 марта — 19 июля 2026';
const festivalKicker = 'К 80-летию Калининградской области';
const qrItems = [
  {
    title: 'Telegram',
    caption: '@kenigevents',
    href: 'https://t.me/+Jhg7TZBUTNc3ZmMy',
    imageSrc: '/generated/telegram/kenigevents-qr-stat.svg',
    imageAlt: 'QR-код Telegram для оперативной информации по фестивалю',
  },
  {
    title: 'MAX',
    caption: 'max.ru',
    href: 'https://max.ru/channel_kenigevents',
    imageSrc: '/generated/max/max-channel-qr.svg',
    imageAlt: 'QR-код MAX для оперативной информации по фестивалю',
  },
];
const copies = [
  { key: 'left', accessible: true },
  { key: 'right', accessible: false },
];
---

<Layout
  title={routeTitle}
  description={routeDescription}
  canonicalPath="/pasport-uchastnika/"
  robots="noindex, nofollow"
>
  <main class="passport-print" data-passport-root data-passport-tone="color">
    <section class="passport-toolbar screen-only" aria-label="Управление макетом">
      <div class="passport-toolbar__copy">
        <p class="passport-toolbar__eyebrow">Печатный макет фестиваля</p>
        <h1>Паспорт участника для A4 и A5</h1>
        <p>
          На печать выводится лист A4 в альбомной ориентации. На нём уже собраны две одинаковые A5-копии
          с безопасными полями и линией реза.
        </p>
      </div>

      <div class="passport-toolbar__actions">
        <div class="passport-toolbar__group" role="group" aria-label="Режим предпросмотра">
          <button class="passport-toolbar__button is-active" type="button" data-tone-button="color">Цветной preview</button>
          <button class="passport-toolbar__button" type="button" data-tone-button="mono">Ч/б preview</button>
        </div>
        <a class="passport-toolbar__button passport-toolbar__button--primary" href="/pasport-uchastnika/passport-a4.pdf" download>
          Скачать PDF
        </a>
        <button class="passport-toolbar__button" type="button" data-passport-print>
          Печать из браузера
        </button>
      </div>
    </section>

    <section class="passport-sheet" aria-label="Лист A4 с двумя копиями паспорта участника">
      <div class="passport-sheet__cutline" aria-hidden="true"></div>

      {copies.map(({ key, accessible }) => (
        <section class={`passport-sheet__half passport-sheet__half--${key}`}>
          <article class="passport-card" aria-hidden={accessible ? undefined : 'true'}>
            <header class="passport-card__header">
              <div class="passport-card__header-copy">
                <p class="passport-card__eyebrow">Просветительский фестиваль</p>
                <p class="passport-card__kicker">{festivalKicker}</p>
                <h2 class="passport-card__document-title" id={`passport-title-${key}`}>Паспорт участника фестиваля</h2>
                <p class="passport-card__festival-name">80 историй о главном</p>
              </div>

              <div class="passport-card__hero-mark">
                <img
                  src="/shared-assets/logo-80-istorii-hero.svg"
                  alt="Логотип фестиваля 80 историй о главном"
                  width="431"
                  height="373"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </header>

            <div class="passport-card__meta">
              <span>{festivalPeriod}</span>
              <a href="https://kgd80.ru" target="_blank" rel="noreferrer" tabindex={accessible ? undefined : -1}>
                kgd80.ru
              </a>
            </div>

            <section class="passport-card__utility" aria-label="Основные условия и каналы фестиваля">
              <section class="passport-card__cta" aria-label="Условия участия">
                <p class="passport-card__cta-lead">Посетите не менее 5 событий фестиваля</p>
                <p class="passport-card__cta-text">
                  лекций или открытых дискуссий, чтобы получить возможность посетить спецпроекты фестиваля
                  или получить дополнительные места на события, где закончились места.
                </p>
              </section>

              <section class="passport-card__info" aria-labelledby={`passport-info-${key}`}>
                <div class="passport-card__info-copy">
                  <p class="passport-card__section-label" id={`passport-info-${key}`}>Оперативная информация по фестивалю</p>
                  <p class="passport-card__info-cta">Подпишитесь</p>
                  <p class="passport-card__info-note">База анонсов событий Калининградской области</p>
                </div>

                <div class="passport-card__qr-grid">
                  {qrItems.map((item) => (
                    <a
                      class="passport-card__qr"
                      href={item.href}
                      target="_blank"
                      rel="noreferrer"
                      tabindex={accessible ? undefined : -1}
                      aria-label={`${item.title}: ${item.caption}`}
                    >
                      <img src={item.imageSrc} alt={item.imageAlt} width="250" height="250" loading="lazy" decoding="async" />
                      <strong>{item.title}</strong>
                      <span>{item.caption}</span>
                    </a>
                  ))}
                </div>
              </section>
            </section>

            <section class="passport-card__identity" aria-labelledby={`passport-name-${key}`}>
              <p class="passport-card__identity-label" id={`passport-name-${key}`}>Фамилия, имя, отчество</p>
              <div class="passport-card__field-line" aria-hidden="true"></div>
            </section>

            <section class="passport-card__stamp-area" aria-labelledby={`passport-stamps-${key}`}>
              <div class="passport-card__stamp-area-head">
                <p class="passport-card__section-label" id={`passport-stamps-${key}`}>Отметки посещения</p>
                <p class="passport-card__stamp-area-note">Свободная область для штампов</p>
              </div>
              <div class="passport-card__stamp-area-field" aria-hidden="true"></div>
            </section>

          </article>
        </section>
      ))}
    </section>
  </main>

  <script is:inline>
    const root = document.querySelector('[data-passport-root]');
    const toneButtons = Array.from(document.querySelectorAll('[data-tone-button]'));
    const printButton = document.querySelector('[data-passport-print]');

    const setTone = (tone) => {
      if (!root) {
        return;
      }

      root.setAttribute('data-passport-tone', tone);
      const url = new URL(window.location.href);
      url.searchParams.set('tone', tone);
      window.history.replaceState({}, '', url);
      toneButtons.forEach((button) => {
        const isActive = button instanceof HTMLElement && button.dataset.toneButton === tone;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    toneButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) {
          return;
        }
        setTone(button.dataset.toneButton || 'color');
      });
    });

    if (printButton instanceof HTMLElement) {
      printButton.addEventListener('click', () => {
        window.print();
      });
    }

    const initialTone = new URL(window.location.href).searchParams.get('tone');
    setTone(initialTone === 'mono' ? 'mono' : 'color');
  </script>
</Layout>

<style>
  @page {
    size: A4 landscape;
    margin: 0;
  }

  .passport-print {
    --passport-sheet-bg: #fbf8f3;
    --passport-card-bg: #fffdf9;
    --passport-card-shadow: 0 18px 42px rgba(77, 42, 21, 0.1);
    --passport-accent: #973823;
    --passport-accent-deep: #6d1f14;
    --passport-accent-soft: rgba(151, 56, 35, 0.08);
    --passport-line: rgba(26, 22, 18, 0.14);
    --passport-line-strong: rgba(26, 22, 18, 0.24);
    --passport-ink: #1c1815;
    --passport-ink-soft: rgba(28, 24, 21, 0.76);
    --passport-ink-muted: rgba(28, 24, 21, 0.52);
    --passport-page-bg: #efe6da;
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.8rem);
    background: var(--passport-page-bg);
  }

  .passport-print[data-passport-tone="mono"] {
    --passport-sheet-bg: #f5f4f1;
    --passport-card-bg: #fffefd;
    --passport-card-shadow: 0 16px 36px rgba(44, 40, 36, 0.1);
    --passport-accent: #2f2a26;
    --passport-accent-deep: #1e1b18;
    --passport-accent-soft: rgba(47, 42, 38, 0.08);
    --passport-line: rgba(24, 21, 18, 0.14);
    --passport-line-strong: rgba(24, 21, 18, 0.24);
    --passport-page-bg: #e9e6e1;
  }

  .passport-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    max-width: 297mm;
    margin: 0 auto 1rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(28, 24, 21, 0.08);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 16px 36px rgba(72, 46, 30, 0.08);
  }

  .passport-toolbar__copy {
    max-width: 38rem;
  }

  .passport-toolbar__eyebrow {
    margin: 0 0 0.2rem;
    color: var(--passport-ink-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-toolbar h1 {
    margin: 0;
    color: var(--passport-ink);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 0.96;
    text-transform: uppercase;
  }

  .passport-toolbar__copy p:last-child {
    margin: 0.55rem 0 0;
    max-width: 34rem;
    color: var(--passport-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .passport-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .passport-toolbar__group {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.28rem;
    border-radius: 999px;
    background: rgba(28, 24, 21, 0.06);
  }

  .passport-toolbar__button {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.75rem 1.05rem;
    background: rgba(255, 255, 255, 0.96);
    color: var(--passport-ink);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .passport-toolbar__button:hover,
  .passport-toolbar__button:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(28, 24, 21, 0.14);
  }

  .passport-toolbar__button.is-active,
  .passport-toolbar__button--primary {
    background: var(--passport-accent-deep);
    color: #fff;
  }

  .passport-sheet {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.95rem;
    width: min(100%, 297mm);
    min-height: 210mm;
    margin: 0 auto;
    padding: 0.9rem;
    border: 1px solid rgba(28, 24, 21, 0.08);
    border-radius: 1.4rem;
    background: var(--passport-sheet-bg);
    box-shadow: 0 24px 56px rgba(78, 50, 31, 0.08);
  }

  .passport-sheet__cutline {
    position: absolute;
    inset: 1rem auto 1rem 50%;
    width: 0;
    border-left: 1px dashed rgba(28, 24, 21, 0.28);
    pointer-events: none;
  }

  .passport-sheet__half {
    display: flex;
    min-height: calc(210mm - 1.8rem);
  }

  .passport-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0.95rem;
    border: 1px solid var(--passport-line-strong);
    border-radius: 1.05rem;
    background: var(--passport-card-bg);
    box-shadow: var(--passport-card-shadow);
    overflow: hidden;
  }

  .passport-card__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(6rem, 7.2rem);
    gap: 0.9rem;
    align-items: start;
  }

  .passport-card__eyebrow {
    margin: 0 0 0.18rem;
    color: var(--passport-ink-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-card__kicker {
    margin: 0 0 0.28rem;
    color: var(--passport-accent);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .passport-card__document-title {
    margin: 0;
    color: var(--passport-ink);
    font-size: clamp(1.55rem, 2.4vw, 2.3rem);
    line-height: 0.94;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .passport-card__festival-name {
    margin: 0.22rem 0 0;
    color: var(--passport-accent);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.08;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-wrap: balance;
  }

  .passport-card__hero-mark {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }

  .passport-card__hero-mark img {
    display: block;
    width: min(100%, 6.9rem);
    height: auto;
  }

  .passport-print[data-passport-tone="mono"] .passport-card__hero-mark img {
    filter: grayscale(1);
  }

  .passport-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--passport-ink-soft);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .passport-card__meta a {
    color: var(--passport-accent-deep);
    text-decoration: none;
  }

  .passport-card__utility {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(50mm, 58mm);
    gap: 0.65rem;
    align-items: start;
  }

  .passport-card__cta {
    height: 100%;
    padding: 0.84rem 0.9rem;
    border-radius: 0.95rem;
    background: var(--passport-accent-deep);
    color: #fff;
  }

  .passport-print[data-passport-tone="mono"] .passport-card__cta {
    background: var(--passport-accent-deep);
  }

  .passport-card__cta-lead {
    margin: 0;
    font-size: 1.06rem;
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .passport-card__cta-text {
    margin: 0.36rem 0 0;
    font-size: 0.82rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.84);
  }

  .passport-card__identity {
    padding: 0.66rem 0.74rem;
    border: 1px solid var(--passport-line);
    border-radius: 0.92rem;
    background: rgba(255, 255, 255, 0.92);
  }

  .passport-card__identity-label {
    margin: 0;
    color: var(--passport-ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .passport-card__section-label {
    margin: 0;
    color: var(--passport-ink-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .passport-card__stamp-area-note,
  .passport-card__info-note {
    margin: 0;
    color: var(--passport-ink-soft);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .passport-card__field-line {
    margin-top: 0.48rem;
    border-bottom: 1.5px solid var(--passport-line-strong);
    min-height: 1rem;
  }

  .passport-card__stamp-area {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding: 0.72rem;
    border: 1px solid var(--passport-line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
  }

  .passport-card__stamp-area-head {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    margin-bottom: 0.55rem;
  }

  .passport-card__stamp-area-field {
    flex: 1;
    min-height: 11rem;
    border: 1px dashed var(--passport-line-strong);
    border-radius: 0.9rem;
    background: #fff;
  }

  .passport-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    padding: 0.72rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--passport-line);
  }

  .passport-card__info-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .passport-card__info-cta {
    margin: 0.1rem 0 0;
    color: var(--passport-accent);
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .passport-card__qr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.42rem;
  }

  .passport-card__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    padding: 0.58rem 0.48rem;
    border: 1px solid var(--passport-line-strong);
    border-radius: 0.9rem;
    background: #fff;
    color: var(--passport-ink);
    text-align: center;
    text-decoration: none;
  }

  .passport-card__qr img {
    display: block;
    width: min(100%, 4.6rem);
    height: auto;
  }

  .passport-card__qr strong {
    font-size: 0.82rem;
    line-height: 1.05;
  }

  .passport-card__qr span {
    color: var(--passport-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  @media (max-width: 1080px) {
    .passport-toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .passport-toolbar__actions {
      justify-content: flex-start;
    }

    .passport-sheet {
      grid-template-columns: 1fr;
      width: min(100%, 28rem);
      min-height: auto;
    }

    .passport-sheet__cutline {
      display: none;
    }

    .passport-sheet__half {
      min-height: auto;
    }

    .passport-card__utility {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .passport-print {
      padding: 0.8rem;
    }

    .passport-toolbar {
      padding: 1rem;
    }

    .passport-toolbar h1 {
      font-size: 1.7rem;
    }

    .passport-card {
      padding: 0.85rem;
    }

    .passport-card__header {
      grid-template-columns: minmax(0, 1fr) 5.4rem;
      gap: 0.75rem;
    }

    .passport-card__document-title {
      font-size: 1.72rem;
    }

    .passport-card__festival-name {
      font-size: 0.88rem;
    }

    .passport-card__stamp-area-field {
      min-height: 10rem;
    }
  }

  @media print {
    :global(html, body) {
      margin: 0;
      padding: 0;
      width: 297mm;
      height: 210mm;
      overflow: hidden;
      background: #fff;
    }

    .screen-only {
      display: none !important;
    }

    .passport-print {
      min-height: auto;
      width: 297mm;
      height: 210mm;
      padding: 0;
      background: #fff;
      --passport-card-bg: #fff;
      --passport-card-shadow: none;
      --passport-page-bg: #fff;
      --passport-sheet-bg: #fff;
      overflow: hidden;
    }

    .passport-sheet {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      width: 297mm;
      height: 210mm;
      max-height: 210mm;
      padding: 4mm 5mm;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      backdrop-filter: none;
      overflow: hidden;
      column-gap: 4mm;
    }

    .passport-sheet__cutline {
      position: absolute;
      inset: 3mm auto 3mm 50%;
      width: 0;
      border-left: 1px dashed rgba(0, 0, 0, 0.35);
    }

    .passport-sheet__half {
      min-height: 0;
      height: 202mm;
      max-height: 202mm;
      overflow: hidden;
    }

    .passport-card {
      height: 100%;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.22);
      gap: 4.2mm;
      padding: 4.8mm 4.8mm 4.6mm;
      overflow: hidden;
    }

    .passport-card__header {
      grid-template-columns: minmax(0, 1fr) 36mm;
      gap: 4mm;
    }

    .passport-card__eyebrow {
      font-size: 0.58rem;
      margin-bottom: 0.2mm;
    }

    .passport-card__kicker {
      font-size: 0.72rem;
      margin-bottom: 1mm;
    }

    .passport-card__document-title {
      font-size: 1.52rem;
    }

    .passport-card__festival-name {
      font-size: 0.82rem;
      margin-top: 1mm;
    }

    .passport-card__hero-mark img {
      width: 100%;
      max-width: 36mm;
    }

    .passport-card__cta {
      padding: 3mm 3.2mm;
      border-radius: 3mm;
    }

    .passport-card__cta-lead {
      font-size: 0.96rem;
    }

    .passport-card__cta-text {
      font-size: 0.72rem;
      margin-top: 1.2mm;
    }

