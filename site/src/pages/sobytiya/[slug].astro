---
import RegistrationClient from '../../components/RegistrationClient.astro';
import EventCard from '../../components/EventCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import {
  getEventEndIso,
  getEventTemporalState,
  getFestivalEventBySlug,
  getFestivalEventHref,
  getFestivalEvents,
  getNextRecordedFestivalEvent,
  getSuggestedFestivalEvents,
} from '../../lib/festival';
import { getRouteNavItems, getSmartProgramHref } from '../../lib/routes';

export function getStaticPaths() {
  return getFestivalEvents().map((event) => ({
    params: { slug: event.slug },
  }));
}

const event = getFestivalEventBySlug(Astro.params.slug ?? '');

if (!event) {
  return Astro.redirect('/programma/');
}

const allEvents = getFestivalEvents();
const routeItems = getRouteNavItems();
const now = new Date();
const temporalState = getEventTemporalState(event, now);
const programHref = getSmartProgramHref(allEvents, false, now);
const recordingsHref = '/zapisi/';
const canonicalPath = getFestivalEventHref(event.slug);
const siteOrigin = (import.meta.env.PUBLIC_SITE_ORIGIN || 'https://kgd80.ru').replace(/\/+$/u, '');
const specialApiBaseUrl = (import.meta.env.PUBLIC_REGISTRATION_API_BASE_URL || 'https://znanie-kgd80-fest.fly.dev').replace(/\/+$/u, '');
const specialApplicationConfigs: Record<string, { href: string; eventSlug: string; token: string; accessTitle: string; accessCopy: string; closedCopy: string }> = {
  'etyudy-toy-vesny': {
    href: '/special/etudy-toy-vesny/',
    eventSlug: 'etudy-toy-vesny',
    token: 'etudy-toy-vesny-debug-20260606',
    accessTitle: 'Как попасть на спектакль',
    accessCopy: 'На розыгрыш приглашений могут подать заявку участники, которые посетили не меньше 5 событий фестиваля и собрали штампы в паспорте участника. Заявка не является билетом: победители получат приглашение на конкретный показ после розыгрыша.',
    closedCopy: 'Заявки на все даты спектакля сейчас недоступны.',
  },
  'premera-novoy-tematicheskoy-ekskursii-po-kaliningradskomu-zooparku': {
    href: '/special/zoo-excursion/',
    eventSlug: 'zoo-excursion',
    token: 'zoo-excursion-20260628',
    accessTitle: 'Как попасть на экскурсию',
    accessCopy: 'На розыгрыш 10 мест могут подать заявку участники, которые посетили не меньше 5 событий фестиваля и собрали штампы в паспорте участника. Заявка не является билетом: победители получат приглашение после розыгрыша.',
    closedCopy: 'Заявки на экскурсию сейчас недоступны.',
  },
  'yantar-excursion': {
    href: '/special/yantar-excursion/',
    eventSlug: 'yantar-excursion',
    token: 'yantar-excursion-20260716',
    accessTitle: 'Как попасть на экскурсию',
    accessCopy: 'На розыгрыш 12 мест могут подать заявку участники, которые посетили не меньше 5 событий фестиваля и собрали штампы в паспорте участника. Победители прошлых спецрозыгрышей остаются в пуле, но с меньшим весом заявки.',
    closedCopy: 'Заявки на экскурсию сейчас недоступны.',
  },
};
const currentSpecialApplication = specialApplicationConfigs[event.slug];
const isSpecialApplicationEvent = Boolean(currentSpecialApplication);
const absoluteEventUrl = new URL(canonicalPath, `${siteOrigin}/`).toString();
const programMonthHref = `/programma/#month-${event.monthAnchor}`;
const descriptionBase = event.summary || event.whyGo || `Событие фестиваля «80 историй о главном»: ${event.title}.`;
const title = `${event.title} | 80 историй о главном`;
const description = [
  event.dateLabel,
  event.timeLabel,
  event.speakerLabel,
  descriptionBase,
].filter(Boolean).join(' · ');
const whyGoCopy = event.whyGo && event.whyGo !== event.summary ? event.whyGo : '';
const metadataParts = [event.dateLabel, event.timeLabel, event.venue].filter(Boolean);
const robots = temporalState === 'past' && !event.recording ? 'noindex, follow, noarchive' : undefined;
const jsonLdStartDate = event.timeLabel ? event.isoStart : event.isoStart?.slice(0, 10);
const jsonLdEndDate = event.timeLabel ? getEventEndIso(event) : event.isoStart?.slice(0, 10);
const jsonLdImage = event.image ? [new URL(event.image, `${siteOrigin}/`).toString()] : undefined;
const jsonLdLocation = event.venue ? {
  '@type': 'Place',
  name: event.venue,
  address: {
    '@type': 'PostalAddress',
    streetAddress: event.address,
    addressLocality: 'Калининград',
    addressCountry: 'RU',
  },
} : undefined;
const jsonLdOrganizer = {
  '@type': 'Organization',
  name: 'Российское общество Знание',
  url: 'https://znanierussia.ru/',
};
const recordingStructuredUrl = event.recording && !event.recording.href.includes('/private/')
  ? event.recording.href
  : undefined;
const jsonLdRecording = recordingStructuredUrl ? {
  '@type': 'VideoObject',
  name: `Запись лекции «${event.title}»`,
  description: descriptionBase,
  thumbnailUrl: jsonLdImage?.[0],
  uploadDate: event.isoStart?.slice(0, 10),
  contentUrl: recordingStructuredUrl,
  url: absoluteEventUrl,
} : undefined;
const recordingPlatformLabel = event.recording?.platform === 'vk-video' ? 'VK Видео' : event.recording ? 'Rutube' : '';
const recordingAriaLabel = recordingPlatformLabel
  ? `Смотреть запись лекции «${event.title}» на ${recordingPlatformLabel}`
  : `Смотреть запись лекции «${event.title}»`;
const recordingNotice = event.recordingNotice;
const nextRecordedEvent = getNextRecordedFestivalEvent(event.slug, allEvents);
const suggestedEvents = getSuggestedFestivalEvents(event, allEvents, now, 6);
const baseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: descriptionBase,
  startDate: jsonLdStartDate,
  endDate: jsonLdEndDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: temporalState === 'past'
    ? 'https://schema.org/EventCompleted'
    : 'https://schema.org/EventScheduled',
  isAccessibleForFree: true,
  url: absoluteEventUrl,
  image: jsonLdImage,
  location: jsonLdLocation,
  organizer: jsonLdOrganizer,
  subjectOf: jsonLdRecording,
};
const etudyStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'EventSeries',
    name: event.title,
    description: descriptionBase,
    url: absoluteEventUrl,
    image: jsonLdImage,
    location: jsonLdLocation,
    organizer: jsonLdOrganizer,
    subEvent: [
      ['11 июня 2026, 18:00', '2026-06-11T18:00:00+02:00'],
      ['23 июня 2026, 18:30', '2026-06-23T18:30:00+02:00'],
      ['25 июня 2026, 18:30', '2026-06-25T18:30:00+02:00'],
    ].map(([label, startDate]) => ({
      '@type': 'Event',
      name: `${event.title}: ${label}`,
      description: descriptionBase,
      startDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      isAccessibleForFree: true,
      url: absoluteEventUrl,
      image: jsonLdImage,
      location: jsonLdLocation,
      organizer: jsonLdOrganizer,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: absoluteEventUrl,
    mainEntity: {
      '@type': 'EventSeries',
      name: event.title,
      url: absoluteEventUrl,
    },
  },
];
const structuredData = event.slug === 'etyudy-toy-vesny' ? etudyStructuredData : baseStructuredData;
---

<Layout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots={robots}
  ogImage={event.image}
  ogType="article"
  structuredData={structuredData}
>
  <div class="page page--event-leaf">
    <div id="top" aria-hidden="true"></div>
    <SiteHeader routeItems={routeItems} programHref={programHref} />

    <main>
      <section class="event-leaf">
        <div class="container">
          <div class="event-leaf__shell">
            <nav class="event-leaf__crumbs" aria-label="Навигация по странице события">
              <a href={programMonthHref}>Программа</a>
              <span aria-hidden="true">/</span>
              {event.recording && (
                <>
                  <a href={recordingsHref}>Записи</a>
                  <span aria-hidden="true">/</span>
                </>
              )}
              <span>{event.title}</span>
            </nav>

            <div class="event-leaf__identity">
              <EventCard
                event={event}
                now={now}
                showActions={false}
                linkToDetails={false}
                expandSummary={true}
                headingLevel="page"
                nextRecordedEvent={nextRecordedEvent}
              />
            </div>

            <div class="event-leaf__hero">
              <div class="event-leaf__copy">
                <p class="event-leaf__eyebrow">О событии</p>
                <p class="event-leaf__meta">{metadataParts.join(' · ')}</p>
                {event.address && <p class="event-leaf__meta">{event.address}</p>}
                {event.publicInfoNotice && <p class="event-leaf__notice">{event.publicInfoNotice}</p>}
                {event.speakerLabel && <p class="event-leaf__speaker">Спикер: {event.speakerLabel}</p>}

                <div class="event-leaf__actions">
                  {event.recording && (
                    <a
                      class="button button--primary event-leaf__recording-link"
                      href={event.recording.href}
                      target="_blank"
                      rel="nofollow noreferrer noopener"
                      aria-label={recordingAriaLabel}
                    >
                      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M8 5.6v12.8L18.6 12 8 5.6Z"></path>
                      </svg>
                      Смотреть запись
                    </a>
                  )}

                  {event.recording && (
                    <nav class="event-leaf__recording-nav" aria-label={`Навигация по записям события «${event.title}»`}>
                      {nextRecordedEvent && (
                        <a
                          class="event-leaf__recording-next"
                          href={getFestivalEventHref(nextRecordedEvent.slug)}
                          aria-label={`Следующая запись: ${nextRecordedEvent.title}`}
                        >
                          Следующая запись: <span>{nextRecordedEvent.title}</span>
                        </a>
                      )}
                      <a class="event-leaf__recording-all" href={recordingsHref}>Все записи</a>
                    </nav>
                  )}

                  {currentSpecialApplication ? (
                    <div class="event-leaf__registration event-leaf__registration--special" data-special-event-cta-card>
                      <a
                        class="button button--primary button--disabled"
                        href={currentSpecialApplication.href}
                        data-special-event-cta
                        data-enabled-href={currentSpecialApplication.href}
                        aria-disabled="true"
                      >
                        Проверяем заявку…
                      </a>
                      <div class="notice" data-special-event-notice hidden></div>
                    </div>
                  ) : temporalState === 'past' && !event.recording && recordingNotice ? (
                    <div class="button button--ghost button--disabled" aria-disabled="true">Запись скоро</div>
                  ) : temporalState === 'past' && !event.recording ? (
                    <div class="button button--ghost button--disabled" aria-disabled="true">Событие прошло</div>
                  ) : temporalState !== 'past' ? (
                    <div class="event-leaf__registration" data-registration-card data-event-slug={event.slug} data-registration-autoload>
                      <button
                        class="button button--primary button--disabled"
                        type="button"
                        data-registration-cta
                        data-registration-autoload
                        data-event-slug={event.slug}
                        data-event-title={event.title}
                        data-event-start={event.isoStart ?? ''}
                        data-event-venue={event.venue}
                        data-event-address={event.address}
                        data-event-speaker={event.speakerLabel}
                        data-registration-state-override={event.publicRegistrationStateOverride ?? ''}
                        disabled
                        aria-disabled="true"
                      >
                        Проверяем регистрацию…
                      </button>
                      <div class="notice" data-registration-notice hidden></div>
                    </div>
                  ) : null}

                  <button
                    class="button button--ghost event-leaf__share"
                    type="button"
                    data-event-share
                    data-share-path={canonicalPath}
                    data-share-title={event.title}
                    hidden
                  >
                    Скопировать ссылку
                  </button>
                  <a class="button button--ghost" href={programMonthHref}>Смотреть другие события</a>
                </div>
                <p class="event-leaf__share-feedback" data-event-share-feedback hidden aria-live="polite"></p>
                <div class="event-leaf__share-manual" data-event-share-manual hidden>
                  <p class="event-leaf__share-manual-title">Ссылка на событие готова</p>
                  <p class="event-leaf__share-manual-copy">Браузер не дал доступ к буферу обмена. Скопируйте ссылку вручную.</p>
                  <input
                    class="event-leaf__share-input"
                    type="text"
                    readonly
                    data-event-share-input
                    aria-label="Прямая ссылка на событие"
                  />
                </div>

                {temporalState !== 'past' && event.calendarReady ? (
                  <div class="event-leaf__calendar" aria-label="Добавить событие в календарь">
                    <a class="event-leaf__calendar-link" href={event.icsUrl}>Android (ICS)</a>
                    <a class="event-leaf__calendar-link" href={event.icsUrl}>Календарь Apple</a>
                    <a
                      class="event-leaf__calendar-link"
                      href={event.googleCalendarUrl}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Google
                    </a>
                  </div>
                ) : temporalState !== 'past' && !currentSpecialApplication && event.calendarNote ? (
                  <p class="event-leaf__notice">{event.calendarNote}</p>
                ) : null}
              </div>
            </div>

            {event.image && (
              <figure class="event-leaf__poster-panel">
                <img src={event.image} alt={`Афиша события ${event.title}`} loading="eager" decoding="async" />
              </figure>
            )}

            <div class="event-leaf__sections">
              {event.recording && (
                <section class="event-leaf__section event-leaf__section--recording" aria-labelledby="event-leaf-recording">
                  <h2 id="event-leaf-recording">Запись лекции</h2>
                  <p class="event-leaf__section-copy">Лекция уже прошла, но запись доступна для просмотра на {recordingPlatformLabel}.</p>
                  <a
                    class="event-leaf__recording-panel"
                    href={event.recording.href}
                    target="_blank"
                    rel="nofollow noreferrer noopener"
                    aria-label={recordingAriaLabel}
                  >
                    <span class="event-leaf__recording-panel-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M8 5.6v12.8L18.6 12 8 5.6Z"></path>
                      </svg>
                    </span>
                    <span>
                      <strong>Открыть запись лекции</strong>
                      <small>{recordingPlatformLabel}</small>
                    </span>
                  </a>
                  <nav class="event-leaf__recording-section-nav" aria-label={`Другие записи после события «${event.title}»`}>
                    {nextRecordedEvent && (
                      <a href={getFestivalEventHref(nextRecordedEvent.slug)}>
                        Следующая запись: <span>{nextRecordedEvent.title}</span>
                      </a>
                    )}
                    <a href={recordingsHref}>Все записи лекций</a>
                  </nav>
                </section>
              )}

              {!event.recording && recordingNotice && (
                <section class="event-leaf__section event-leaf__section--recording" aria-labelledby="event-leaf-recording">
                  <h2 id="event-leaf-recording">Запись лекции</h2>
                  <p class="event-leaf__section-copy">{recordingNotice.description}</p>
                  <div class="event-leaf__recording-panel event-leaf__recording-panel--pending">
                    <span class="event-leaf__recording-panel-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm0 2a7.25 7.25 0 1 1 0 14.5 7.25 7.25 0 0 1 0-14.5Zm.75 2.9h-1.9v5.15l4.1 2.55.98-1.58-3.18-1.9V7.65Z"></path>
                      </svg>
                    </span>
                    <span>
                      <strong>{recordingNotice.label}</strong>
                    </span>
                  </div>
                </section>
              )}

              {currentSpecialApplication && (
                <section class="event-leaf__section event-leaf__section--special-access" aria-labelledby="event-leaf-special-access">
                  <h2 id="event-leaf-special-access">{currentSpecialApplication.accessTitle}</h2>
                  <p class="event-leaf__section-copy">{currentSpecialApplication.accessCopy}</p>
                  <div class="event-leaf__actions">
                    <a
                      class="button button--primary button--disabled"
                      href={currentSpecialApplication.href}
                      data-special-event-cta
                      data-enabled-href={currentSpecialApplication.href}
                      aria-disabled="true"
                    >
                      Проверяем заявку…
                    </a>
                    <a class="button button--ghost" href="/programma/">Выбрать события фестиваля</a>
                  </div>
                </section>
              )}

              {whyGoCopy && (
                <section class="event-leaf__section" aria-labelledby="event-leaf-why-go">
                  <h2 id="event-leaf-why-go">Почему стоит прийти</h2>
                  <p class="event-leaf__section-copy">{whyGoCopy}</p>
                </section>
              )}

              {event.speakerAbout && (
                <section class="event-leaf__section" aria-labelledby="event-leaf-speaker">
                  <h2 id="event-leaf-speaker">О спикере</h2>
                  <p class="event-leaf__section-copy">{event.speakerAbout}</p>
                </section>
              )}

              {event.questions.length > 0 && (
                <section class="event-leaf__section" aria-labelledby="event-leaf-questions">
                  <h2 id="event-leaf-questions">О чём поговорим</h2>
                  <ul class="event-leaf__question-list">
                    {event.questions.map((question) => (
                      <li>{question}</li>
                    ))}
                  </ul>
                </section>
              )}

              {event.speakerLectureLinks.length > 0 && (
                <section class="event-leaf__section" aria-labelledby="event-leaf-more">
                  <h2 id="event-leaf-more">Ещё у лектора</h2>
                  <ul class="event-leaf__more-list">
                    {event.speakerLectureLinks.map((lecture) => (
                      <li>
                        <a href={getFestivalEventHref(lecture.slug)}>{lecture.title}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>

            {suggestedEvents.length > 0 && (
              <section class="event-leaf__suggestions" aria-labelledby="event-leaf-suggestions">
                <div class="event-leaf__suggestions-head">
                  <p class="event-leaf__eyebrow">Продолжить маршрут</p>
                  <h2 id="event-leaf-suggestions">Вам могут быть интересны</h2>
                  <p>Другие будущие события фестиваля, которые можно выбрать после этой страницы.</p>
                </div>
                <div class="event-leaf__suggestion-grid">
                  {suggestedEvents.map((candidate) => (
                    <a class="event-leaf__suggestion-card" href={getFestivalEventHref(candidate.slug)}>
                      <span class="event-leaf__suggestion-label">{candidate.relationLabel}</span>
                      <strong>{candidate.title}</strong>
                      <span>{candidate.formatLabel} · {candidate.dateLabel}{candidate.timeLabel && !candidate.timeLabel.includes('будет объявлено') ? ` · ${candidate.timeLabel}` : ''}</span>
                      <small>{[candidate.speakerLabel, candidate.venue].filter(Boolean).join(' · ')}</small>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter routeItems={routeItems} programHref={programHref} />
    <RegistrationClient />
  </div>

  {currentSpecialApplication && (
    <script define:vars={{ specialApiBaseUrl, currentSpecialApplication }} is:inline>
      const specialCtas = Array.from(document.querySelectorAll('[data-special-event-cta]'));
      const specialNotice = document.querySelector('[data-special-event-notice]');

      const setSpecialCta = (disabled, label, noticeText) => {
        specialCtas.forEach((specialCta) => {
          if (!(specialCta instanceof HTMLAnchorElement)) {
            return;
          }
          specialCta.textContent = label;
          specialCta.classList.toggle('button--disabled', disabled);
          specialCta.classList.toggle('button--ghost', disabled);
          specialCta.classList.toggle('button--primary', !disabled);
          specialCta.setAttribute('aria-disabled', disabled ? 'true' : 'false');
          if (disabled) {
            if (specialCta.hasAttribute('href')) {
              specialCta.dataset.enabledHref = specialCta.getAttribute('href') || specialCta.dataset.enabledHref || '';
            }
            specialCta.removeAttribute('href');
          } else if (!specialCta.hasAttribute('href') && specialCta.dataset.enabledHref) {
            specialCta.href = specialCta.dataset.enabledHref;
          }
        });

        if (specialNotice instanceof HTMLElement) {
          specialNotice.hidden = !noticeText;
          specialNotice.textContent = noticeText || '';
        }
      };

      const hydrateSpecialEventCta = async () => {
        if (!specialCtas.some((specialCta) => specialCta instanceof HTMLAnchorElement)) {
          return;
        }

        setSpecialCta(true, 'Проверяем заявку…', '');
        try {
          const response = await fetch(`${specialApiBaseUrl}/api/v1/special/events/${currentSpecialApplication.eventSlug}?token=${encodeURIComponent(currentSpecialApplication.token)}`, {
            cache: 'no-store',
          });
          if (!response.ok) {
            throw new Error('special_event_unavailable');
          }
          const data = await response.json();
          const showings = Array.isArray(data?.showings) ? data.showings : [];
          const availableShowings = showings.filter((showing) => showing?.applicationAvailable);
          if (data?.applicationAvailable && availableShowings.length) {
            setSpecialCta(false, 'Подать заявку на розыгрыш', `Доступно дат для заявки: ${availableShowings.length}. Заявка не является билетом.`);
          } else {
            setSpecialCta(true, 'Заявки закрыты', currentSpecialApplication.closedCopy || 'Заявки сейчас недоступны.');
          }
        } catch {
          setSpecialCta(true, 'Статус заявки недоступен', 'Не удалось проверить доступность заявки. Обновите страницу чуть позже.');
        }
      };

      void hydrateSpecialEventCta();
    </script>
  )}
</Layout>
