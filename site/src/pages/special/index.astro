---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getFestivalEvents } from '../../lib/festival';
import { getRouteNavItems, getSmartProgramHref } from '../../lib/routes';

const events = getFestivalEvents();
const now = new Date();
const routeItems = getRouteNavItems();
const programHref = getSmartProgramHref(events, false, now);
const title = 'Спецмероприятия фестиваля | 80 историй о главном';
const description = 'Спецмероприятия фестиваля: отдельные регистрации, экскурсии, спектакли и события с заявкой по паспорту участника.';
const specialCards = [
  {
    title: 'Стендап-презентация сайта анонсов событий',
    kicker: 'Регистрация открыта',
    meta: '30 июля 18:30 · Калининградский областной историко-художественный музей',
    text: 'Почему одни сервисы удобные, а другие нет? На встрече покажем, как создаются понятные сервисы, как решаются задачи персонализации и персонального подбора событий, и впервые продемонстрируем продукт, который позже станет общедоступным.',
    href: '/sobytiya/stendap-prezentatsiya-sayta-anonsov-sobytiy/?register=1',
    image: '/generated/events/stendap-prezentatsiya-sayta-anonsov-sobytiy.svg',
    imageAlt: 'Афиша стендап-презентации сайта анонсов событий',
    imageWidth: 1600,
    imageHeight: 1050,
    cta: 'Зарегистрироваться',
  },
  {
    title: 'Экскурсия «Слон по городу идёт»',
    kicker: 'Новая дата',
    meta: '12 июля 14:00 · воскресенье',
    text: 'Экскурсия «Слон по городу идёт» состоится 12 июля в 14:00. Результаты розыгрыша сохраняются; коммерческий билет на экскурсию можно купить по ссылке, победителей розыгрыша это не касается.',
    href: '/special/zoo-excursion/',
    image: '/generated/events/zoopark-sokolova.webp',
    imageAlt: 'Зебра в Калининградском зоопарке',
    imageWidth: 900,
    imageHeight: 1200,
    cta: 'Подробнее',
  },
  {
    title: 'Экскурсия на судостроительный завод ОСК «Янтарь»',
    kicker: 'Новый спецпроект',
    meta: '16 июля 18:00 · 12 мест в розыгрыше · 10 мест резерв',
    text: 'Музей калининградского кораблестроения и производственные площадки завода — редкий маршрут в «город в городе».',
    href: '/special/yantar-excursion/',
    image: '/generated/special/yantar-excursion.webp',
    imageAlt: 'Корпус судна и краны на территории завода «Янтарь»',
    imageWidth: 1800,
    imageHeight: 1350,
    cta: 'Подать заявку',
  },
  {
    title: 'Этюды той весны',
    kicker: 'Иммерсивный спектакль',
    meta: '11, 23 и 25 июня · Южный вокзал',
    text: 'Спектакль на основе реальных историй первых переселенцев в Калининградскую область.',
    href: '/special/etudy-toy-vesny/',
    image: '/generated/special/etudy-toy-vesny-immersive-hero.webp',
    imageAlt: 'Герои иммерсивного спектакля «Этюды той весны»',
    imageWidth: 1800,
    imageHeight: 1350,
    cta: 'Подробнее',
  },
];
---

<Layout title={title} description={description} canonicalPath="/special/" ogImage="/generated/special/yantar-excursion.webp">
  <div class="page page--special-index">
    <SiteHeader routeItems={routeItems} programHref={programHref} />
    <main class="special-index">
      <section class="special-index__hero">
        <div class="container special-index__hero-grid">
          <div>
            <p class="section__eyebrow">Спецмероприятия</p>
            <h1>Спецмероприятия фестиваля</h1>
            <p>Здесь собраны специальные форматы с разными правилами участия. На одни события действует отдельная регистрация, на другие нужно подать заявку, подтвердить посещения фестиваля паспортом участника и дождаться результатов розыгрыша.</p>
          </div>
          <a class="button button--primary" href="/programma/">Вернуться к программе</a>
        </div>
      </section>

      <section class="special-index__list" aria-label="Список спецмероприятий">
        <div class="container special-index__cards">
          {specialCards.map((card) => (
            <article class="special-index-card">
              <a class="special-index-card__image" href={card.href} aria-label={card.title}>
                <img src={card.image} alt={card.imageAlt} width={card.imageWidth} height={card.imageHeight} loading="eager" decoding="async" />
              </a>
              <div class="special-index-card__body">
                <p>{card.kicker}</p>
                <h2>{card.title}</h2>
                <strong>{card.meta}</strong>
                <span>{card.text}</span>
                <a class="button button--primary" href={card.href}>{card.cta}</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter routeItems={routeItems} programHref={programHref} />
  </div>
</Layout>

<style>
  .special-index {
    padding-block: calc(var(--site-header-height, 5rem) + 1.5rem) 4rem;
    background: linear-gradient(180deg, #fff8ef 0%, #f2e6d9 100%);
    min-height: 100dvh;
  }

  .special-index__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: end;
  }

  .special-index__hero h1 {
    max-width: 13ch;
    margin: 0.2rem 0 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.9;
    overflow-wrap: break-word;
  }

  .special-index__hero p:not(.section__eyebrow) {
    max-width: 42rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.55;
  }

  .special-index__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .special-index-card {
    overflow: hidden;
    border: 1px solid rgba(94, 57, 30, 0.12);
    border-radius: 1.4rem;
    background: rgba(255, 252, 247, 0.9);
    box-shadow: 0 1rem 2.8rem rgba(77, 41, 22, 0.09);
  }

  .special-index-card__image {
    display: block;
    aspect-ratio: 4 / 3;
    background: #eadbca;
  }

  .special-index-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .special-index-card__body {
    display: grid;
    gap: 0.72rem;
    padding: 1.1rem;
  }

  .special-index-card__body p {
    margin: 0;
    color: var(--accent-deep);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .special-index-card__body h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.95rem);
    line-height: 1.02;
  }

  .special-index-card__body strong,
  .special-index-card__body span {
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .special-index-card__body .button {
    width: fit-content;
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .special-index__hero-grid,
    .special-index__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .special-index__hero-grid > div {
      min-width: 0;
    }

    .special-index__hero-grid > .button {
      width: fit-content;
    }
  }

  @media (max-width: 520px) {
    .special-index {
      padding-block-start: calc(var(--site-header-height, 4rem) + 1rem);
    }

    .special-index__hero h1 {
      max-width: none;
      font-size: clamp(1.9rem, 9.8vw, 3.8rem);
    }
  }
</style>
